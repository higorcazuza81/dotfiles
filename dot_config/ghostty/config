# ~/.config/ghostty/config

# --- Tema ---
theme = "iTerm2 Default"

# --- Fundo escuro com transparência ---
background-opacity = 0.90
background-blur = true
background-opacity-cells = true

# Sem barra de titulo da janela
window-decoration = false

# --- Fonte ---
font-family = "JetBrainsMono Nerd Font"
font-size = 13

# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# --- Integração de shell (com SSH corrigido) ---
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# --- Scrollback ---
scrollback-limit = 100000

# --- Painéis ---
unfocused-split-opacity = 0.7

# --- Produtividade ---
copy-on-select = clipboard
mouse-hide-while-typing = true
window-inherit-working-directory = true

# --- Espaçamento ---
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# --- Segurança: confirma antes de fechar painel com processo rodando ---
confirm-close-surface = true

# --- Restaura layout de janela entre reinícios do Ghostty ---
window-save-state = always

# --- Notificação quando comando demorado termina ---
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 30s

# ~/.config/ghostty/config
command = tmux new-session -A -s main
