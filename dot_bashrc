# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples
#
# Rationale for non-obvious decisions in this file (load order, fzf/bash-
# completion interaction, fd/bat renaming) lives in the dotfiles repo's
# README and docs/, not here: see https://github.com/higorcazuza81/dotfiles

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# ------------------------------------------------------------
# HISTORICO
# ------------------------------------------------------------
# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth
# append to the history file, don't overwrite it
shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000
HISTTIMEFORMAT="%F %T "

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# ------------------------------------------------------------
# QoL SHOPTS
# ------------------------------------------------------------
shopt -s globstar     # ** for recursive globbing
shopt -s autocd       # typing a bare directory name cds into it
shopt -s cdspell      # autocorrects minor typos in cd targets
shopt -s dirspell     # same, during tab-completion of paths

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ------------------------------------------------------------
# PROMPT
#   Starship owns the prompt where it's installed (see FERRAMENTAS below).
#   Where it isn't -- servers, deliberately -- a minimal red PS1 kicks in
#   instead: different on purpose, so a server never looks like the local
#   machine at a glance. See docs/starship.md in the dotfiles repo.
# ------------------------------------------------------------

# ------------------------------------------------------------
# CORES DE LS / GREP
# ------------------------------------------------------------
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# ls aliases: eza when present (icons, git status), plain ls as fallback
# so the same .bashrc still works on a bare server without eza installed
if command -v eza >/dev/null 2>&1; then
    alias ll='eza -l --all --group-directories-first --icons --git'
    alias la='eza --all --icons'
    alias l='eza --icons'
    alias lt='eza --tree --level=2 --icons'
else
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi

# Add an "alert" alias for long running commands. Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# ------------------------------------------------------------
# ALIASES ADICIONAIS
# ------------------------------------------------------------
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# case-insensitive tab completion
bind "set completion-ignore-case on" 2>/dev/null

# ------------------------------------------------------------
# COMPLETION NATIVO DO BASH (Tab)
#   Precisa carregar ANTES do fzf: os dois se registram no mesmo
#   mecanismo de completion, e quem carrega por ultimo vence.
# ------------------------------------------------------------
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# ------------------------------------------------------------
# PATH
#   ~/.local/bin primeiro: symlinks fd->fdfind, bat->batcat (ver
#   docs/cli-tools.md para o motivo dos symlinks existirem).
# ------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# ------------------------------------------------------------
# FERRAMENTAS
# ------------------------------------------------------------

# Starship owns the prompt only where it's actually installed (this
# laptop). Deliberately NOT installed on servers -- see the fallback
# below and docs/starship.md.
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    # Minimal, unmistakably-not-local prompt: bold white-on-red
    # user@host badge, red path. No external tool, works on any bash.
    PS1='\[\e[1;37;41m\] \u@\h \[\e[0m\] \[\e[1;31m\]\w\[\e[0m\] \$ '
fi

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"

# ------------------------------------------------------------
# FZF — busca fuzzy: keybindings + completion
#   Ctrl+R historico | Ctrl+T arquivos | Alt+C cd fuzzy
#   Ctrl+X Ctrl+R reverse-i-search nativo do bash (ver docs/tmux
#   e docs/cli-tools.md para o motivo do remapeamento)
# ------------------------------------------------------------
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

export FZF_DEFAULT_OPTS='--height 60% --layout=reverse --border --info=inline --cycle'

export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}' --preview-window right:60%:wrap"
export FZF_ALT_C_OPTS="--preview 'tree -C {} 2>/dev/null | head -100' --preview-window right:50%"
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:hidden:wrap --bind '?:toggle-preview'"

if command -v fzf >/dev/null 2>&1; then
  if fzf --bash >/dev/null 2>&1; then
    eval "$(fzf --bash)"
  else
    # fzf antigo (pacote do apt): scripts de integracao vem em disco
    for _fzf_file in \
      /usr/share/doc/fzf/examples/key-bindings.bash \
      /usr/share/doc/fzf/examples/completion.bash \
      /usr/share/bash-completion/completions/fzf
    do
      [ -f "$_fzf_file" ] && . "$_fzf_file"
    done
    unset _fzf_file
  fi

  bind '"\C-x\C-r": reverse-search-history' 2>/dev/null
fi

# ------------------------------------------------------------
# TMUX
# ------------------------------------------------------------
alias tmux-restore='tmux run-shell ~/.tmux/plugins/tmux-resurrect/scripts/restore.sh'
alias tmux-save='tmux run-shell ~/.tmux/plugins/tmux-resurrect/scripts/save.sh'
