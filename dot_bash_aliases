# ~/.bash_aliases — carregado pelo ~/.bashrc
#
# Regra desta casa: ferramenta moderna e CAMADA por cima do
# fundamento, nunca substituicao do nome dele.
#   - nao existe 'alias cat=bat'  (bat pagina e colore; quebra pipe)
#   - nao existe 'alias find=fd'  (sintaxe diferente; find e o que
#     existe em qualquer servidor e o que a Fase 0 cobra)

# ------------------------------------------------------------
# MISSAO 9 — renomeacao dos binarios do Debian/Ubuntu
#   No Debian/Ubuntu (e portanto Pop!_OS) esses dois binarios sao
#   renomeados por colisao de nome com pacotes ja existentes:
#     fd  -> fdfind
#     bat -> batcat
#
#   ATENCAO: alias so vale em shell INTERATIVO. Nao funciona em
#   script, em xargs, em subshell nem dentro de FZF_DEFAULT_COMMAND.
#   Por isso existem tambem os symlinks em ~/.local/bin (ver
#   setup-terminal.sh). Estes aliases sao redundantes com o symlink
#   e ficam aqui de proposito, como registro do exercicio.
#
#   Prove a diferenca voce mesmo:
#     fd --version              # alias resolve
#     bash -c 'fd --version'    # so o symlink salva
# ------------------------------------------------------------
command -v fdfind  >/dev/null 2>&1 && alias fd='fdfind'
command -v batcat  >/dev/null 2>&1 && alias bat='batcat'

# ------------------------------------------------------------
# ATALHOS DE USO DIARIO
# ------------------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias mkdir='mkdir -pv'

